#!/usr/bin/env bash
#PBS -N fixed_m_sweep
#PBS -P 12004268
#PBS -q ai
#PBS -J 1-12
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=4:00:00
#PBS -j oe
set -eo pipefail
cd "${PBS_O_WORKDIR:-.}"
case "${FIXED_M:-}" in
  0.1|0.3|0.7|0.9) ;;
  *) echo "FIXED_M must be 0.1, 0.3, 0.7 or 0.9" >&2; exit 2 ;;
esac
index=${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-}}
[[ "$index" =~ ^([1-9]|1[0-2])$ ]] || { echo "Expected array index 1-12" >&2; exit 2; }
variants=(chain_random metamix_fixed_m)
losses=(js infonce)
seeds=(17 23 43)
variant=${variants[(index-1)/6]}
loss=${losses[((index-1)/3)%2]}
seed=${seeds[(index-1)%3]}
out="experiments/fixed_m_sweep_bs32/m${FIXED_M}/${variant}_${loss}/seed${seed}"
args=(reproduce/unrolled_mixing.py --variant "$variant" --consistency "$loss"
      --fixed-m "$FIXED_M" --seed "$seed" --outer-consistency js --batch-size 32
      --classifier-lr 0.003 --mixer-lr 0.005 --temperature 0.1
      --root "${DATA_ROOT:-experiments/metamix_cifar10/data}" --output "$out")
if [[ ${DRY_RUN:-0} == 1 ]]; then
    printf 'python '; printf '%q ' "${args[@]}"; printf '\n'; exit 0
fi
[[ ! -f "$out/complete.json" ]] || exit 0
source activate base
conda activate "${TRAIN_ENV:-survival_analysis}"
export MPLCONFIGDIR="${TMPDIR:-/tmp}/mpl-${PBS_JOBID}-${index}"
mkdir -p "$MPLCONFIGDIR" "$out"
exec python -u "${args[@]}" >>"$out/launcher.log" 2>&1
