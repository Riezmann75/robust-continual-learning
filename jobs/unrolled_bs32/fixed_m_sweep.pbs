#!/usr/bin/env bash
#PBS -N fixed_m_sweep
#PBS -P 12004268
#PBS -q ai
#PBS -J 1-4
#PBS -l select=1:ncpus=12:mem=64gb:ngpus=1
#PBS -l walltime=8:00:00
#PBS -j oe
set -eo pipefail
cd "${PBS_O_WORKDIR:-.}"
case "${FIXED_M:-}" in
  0.1|0.3|0.7|0.9) ;;
  *) echo "FIXED_M must be 0.1, 0.3, 0.7 or 0.9" >&2; exit 2 ;;
esac
index=${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-}}
[[ "$index" =~ ^[1-4]$ ]] || { echo "Expected array index 1-4" >&2; exit 2; }
variants=(chain_random metamix_fixed_m)
losses=(js infonce)
variant=${variants[(index-1)/2]}
loss=${losses[(index-1)%2]}
if [[ ${DRY_RUN:-0} != 1 ]]; then
    source activate base
    conda activate "${TRAIN_ENV:-survival_analysis}"
    export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
fi

pids=()
launched_seeds=()
for seed in 17 23 43; do
    out="experiments/fixed_m_sweep_bs32/m${FIXED_M}/${variant}_${loss}/seed${seed}"
    args=(reproduce/unrolled_mixing.py --variant "$variant" --consistency "$loss"
          --fixed-m "$FIXED_M" --seed "$seed" --outer-consistency js --batch-size 32
          --classifier-lr 0.003 --mixer-lr 0.005 --temperature 0.1
          --root "${DATA_ROOT:-experiments/metamix_cifar10/data}" --output "$out")
    if [[ ${DRY_RUN:-0} == 1 ]]; then
        printf 'python '; printf '%q ' "${args[@]}"; printf '\n'; continue
    fi
    [[ ! -f "$out/complete.json" ]] || continue
    cache="${TMPDIR:-/tmp}/mpl-${PBS_JOBID}-${index}-${seed}"
    mkdir -p "$cache" "$out"
    MPLCONFIGDIR="$cache" python -u "${args[@]}" >>"$out/launcher.log" 2>&1 &
    pids+=("$!")
    launched_seeds+=("$seed")
done

status=0
for i in "${!pids[@]}"; do
    if ! wait "${pids[i]}"; then
        echo "Training failed for seed ${launched_seeds[i]} ($variant, $loss, m=$FIXED_M)" >&2
        status=1
    fi
done
exit "$status"
