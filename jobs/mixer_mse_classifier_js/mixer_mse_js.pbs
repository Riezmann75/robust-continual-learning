#!/usr/bin/env bash
#PBS -N mixer_mse_js
#PBS -P 12004268
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=4:00:00
#PBS -J 1-9
#PBS -j oe
#PBS -m abe
#PBS -M giabao.cao@ntu.edu.sg

# Generated by generate_hpc_job.py. Edit the JSON source and regenerate rather
# than hand-editing this file.
set -eo pipefail

if [[ -n "${PBS_O_WORKDIR:-}" ]]; then
  PROJECT_DIR="$PBS_O_WORKDIR"
else
  PROJECT_DIR="$(git rev-parse --show-toplevel)"
fi
cd "$PROJECT_DIR"

GRID_INDEX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-1}}"
if [[ -z "$GRID_INDEX" ]]; then
  echo "PBS array index is unavailable" >&2
  exit 2
fi

EXP_NAME="${EXP_NAME:-}"
if [[ ! "$EXP_NAME" =~ ^[A-Za-z0-9_.-]+$ ]]; then
  echo "EXP_NAME must contain only letters, numbers, dots, underscores, or hyphens" >&2
  exit 2
fi

RAW_JOB_ID="${PBS_JOBID:-manual[]}"
ARRAY_JOB_NUMBER="${RAW_JOB_ID%%[*}"
ARRAY_JOB_NUMBER="${ARRAY_JOB_NUMBER%%.*}"
ARRAY_JOB_TAG="${ARRAY_JOB_NUMBER}[]"
RUN_NAME="${EXP_NAME}_${GRID_INDEX}"
EXPERIMENT_PATH=experiments/mixer_mse_classifier_js
ARRAY_OUTPUT_ROOT="$PROJECT_DIR/$EXPERIMENT_PATH/$EXP_NAME/$ARRAY_JOB_TAG"
OUTPUT_DIR="$ARRAY_OUTPUT_ROOT/$RUN_NAME"
GRID_MANIFEST_REL=jobs/mixer_mse_classifier_js/mixer_mse_js_grid_manifest.json
GRID_MANIFEST="$PROJECT_DIR/$GRID_MANIFEST_REL"

case "$GRID_INDEX" in
  1)
    TRAIN_COMMAND=(
  python
  -u
  scripts/train_mixer_severity.py
  --objective
  feature_mse
  --classifier-consistency
  js
  --severity-upperbound
  3
  --seed
  17
      --output-dir "$OUTPUT_DIR"
    )
    ;;
  2)
    TRAIN_COMMAND=(
  python
  -u
  scripts/train_mixer_severity.py
  --objective
  feature_mse
  --classifier-consistency
  js
  --severity-upperbound
  3
  --seed
  28
      --output-dir "$OUTPUT_DIR"
    )
    ;;
  3)
    TRAIN_COMMAND=(
  python
  -u
  scripts/train_mixer_severity.py
  --objective
  feature_mse
  --classifier-consistency
  js
  --severity-upperbound
  3
  --seed
  39
      --output-dir "$OUTPUT_DIR"
    )
    ;;
  4)
    TRAIN_COMMAND=(
  python
  -u
  scripts/train_mixer_severity.py
  --objective
  feature_mse
  --classifier-consistency
  js
  --severity-upperbound
  5
  --seed
  17
      --output-dir "$OUTPUT_DIR"
    )
    ;;
  5)
    TRAIN_COMMAND=(
  python
  -u
  scripts/train_mixer_severity.py
  --objective
  feature_mse
  --classifier-consistency
  js
  --severity-upperbound
  5
  --seed
  28
      --output-dir "$OUTPUT_DIR"
    )
    ;;
  6)
    TRAIN_COMMAND=(
  python
  -u
  scripts/train_mixer_severity.py
  --objective
  feature_mse
  --classifier-consistency
  js
  --severity-upperbound
  5
  --seed
  39
      --output-dir "$OUTPUT_DIR"
    )
    ;;
  7)
    TRAIN_COMMAND=(
  python
  -u
  scripts/train_mixer_severity.py
  --objective
  feature_mse
  --classifier-consistency
  js
  --severity-upperbound
  7
  --seed
  17
      --output-dir "$OUTPUT_DIR"
    )
    ;;
  8)
    TRAIN_COMMAND=(
  python
  -u
  scripts/train_mixer_severity.py
  --objective
  feature_mse
  --classifier-consistency
  js
  --severity-upperbound
  7
  --seed
  28
      --output-dir "$OUTPUT_DIR"
    )
    ;;
  9)
    TRAIN_COMMAND=(
  python
  -u
  scripts/train_mixer_severity.py
  --objective
  feature_mse
  --classifier-consistency
  js
  --severity-upperbound
  7
  --seed
  39
      --output-dir "$OUTPUT_DIR"
    )
    ;;
  *)
    echo "Unexpected grid index: $GRID_INDEX" >&2
    exit 2
    ;;
esac

printf 'Array job: %s
' "$ARRAY_JOB_TAG"
printf 'Grid index: %s/%s
' "$GRID_INDEX" 9
printf 'Run name: %s
' "$RUN_NAME"
printf 'Output: %s
' "$OUTPUT_DIR"
printf 'Command:'
printf ' %q' "${TRAIN_COMMAND[@]}"
printf '
'

if [[ "${DRY_RUN:-0}" == "1" ]]; then
  exit 0
fi

mkdir -p "$OUTPUT_DIR"
if [[ "$GRID_INDEX" == "1" ]]; then
  cp "$GRID_MANIFEST" "$ARRAY_OUTPUT_ROOT/"
fi

source activate base
conda activate survival_analysis

if [[ ! -f scripts/train_mixer_severity.py ]]; then
  echo "Training script does not exist: scripts/train_mixer_severity.py" >&2
  exit 3
fi

export MPLCONFIGDIR="${TMPDIR:-/tmp}/matplotlib-${PBS_JOBID:-manual}"
export OMP_NUM_THREADS="${NCPUS:-8}"
mkdir -p "$MPLCONFIGDIR"

"${TRAIN_COMMAND[@]}" 2>&1 | tee "$OUTPUT_DIR/train.log"
