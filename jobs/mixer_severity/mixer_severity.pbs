# Generated by generate_hpc_job.py. Each GPU runs up to 1 concurrent experiments.
set -eo pipefail

if [[ -n "${PBS_O_WORKDIR:-}" ]]; then
  PROJECT_DIR="$PBS_O_WORKDIR"
else
  PROJECT_DIR="$(git rev-parse --show-toplevel)"
fi
cd "$PROJECT_DIR"

TASK_INDEX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-1}}"
if [[ -z "$TASK_INDEX" ]]; then
  echo "PBS array index is unavailable" >&2
  exit 2
fi

EXP_NAME="${EXP_NAME:-}"
if [[ ! "$EXP_NAME" =~ ^[A-Za-z0-9_.-]+$ ]]; then
  echo "EXP_NAME must contain only letters, numbers, dots, underscores, or hyphens" >&2
  exit 2
fi

RAW_JOB_ID="${PBS_JOBID:-manual[]}"
ARRAY_JOB_NUMBER="${RAW_JOB_ID%%[*}"
ARRAY_JOB_NUMBER="${ARRAY_JOB_NUMBER%%.*}"
ARRAY_JOB_TAG="${ARRAY_JOB_NUMBER}[]"
EXPERIMENT_PATH=experiments/mixer_severity_bs128_cosine
ARRAY_OUTPUT_ROOT="$PROJECT_DIR/$EXPERIMENT_PATH/$EXP_NAME/$ARRAY_JOB_TAG"
GRID_MANIFEST_REL=jobs/mixer_severity/mixer_severity_grid_manifest.json
GRID_MANIFEST="$PROJECT_DIR/$GRID_MANIFEST_REL"

