    OUTPUT_DIR_0="$ARRAY_OUTPUT_ROOT/${RUN_NAME_0}"
    TRAIN_COMMAND_0=(
  python
  -u
  scripts/train_mixer_severity.py
  --objective
  metamix
  --severity-upperbound
  3
  --seed
  17
  --classifier-lr
  0.012
  --mixer-lr
  0.02
  --batch-size
  128
  --momentum
  0.9
  --scheduler
  cosine
  --scheduler-period
