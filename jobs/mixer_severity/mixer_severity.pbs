printf 'Array job: %s\n' "$ARRAY_JOB_TAG"
printf 'Array task: %s/%s (%s GPU(s), %s experiment(s) this task; %s total)\n' \
  "$TASK_INDEX" 18 1 "$RUN_COUNT" 18
if (( RUN_COUNT > 0 )); then printf 'Experiment 0: grid %s, output %s\n' "$GRID_INDEX_0" "$OUTPUT_DIR_0"; fi
if (( RUN_COUNT > 0 )); then printf 'Command 0:'; printf ' %q' "${TRAIN_COMMAND_0[@]}"; printf '\n'; fi

if [[ "${DRY_RUN:-0}" == "1" ]]; then
  exit 0
fi

if (( RUN_COUNT > 0 )); then mkdir -p "$OUTPUT_DIR_0"; fi
if [[ "$TASK_INDEX" == "1" ]]; then
  cp "$GRID_MANIFEST" "$ARRAY_OUTPUT_ROOT/"
fi

source activate base
conda activate survival_analysis

if [[ ! -f scripts/train_mixer_severity.py ]]; then
  echo "Training script does not exist: scripts/train_mixer_severity.py" >&2
  exit 3
fi

export MPLCONFIGDIR="${TMPDIR:-/tmp}/matplotlib-${PBS_JOBID:-manual}"
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8
mkdir -p "$MPLCONFIGDIR"

GPU_LIST="${CUDA_VISIBLE_DEVICES:-}"
if [[ -z "$GPU_LIST" ]]; then
  GPU_LIST="0"
fi
IFS=',' read -r -a ALLOCATED_GPUS <<< "$GPU_LIST"
if (( ${#ALLOCATED_GPUS[@]} < 1 )); then
  echo "Expected 1 allocated GPUs, got: $GPU_LIST" >&2
  exit 4
fi

PIDS=()
if (( RUN_COUNT > 0 )); then
(
CUDA_VISIBLE_DEVICES="${ALLOCATED_GPUS[0]}" "${TRAIN_COMMAND_0[@]}" 2>&1 | tee "$OUTPUT_DIR_0/train.log"
) &
PIDS[0]=$!
fi

STATUS=0
for PID in "${PIDS[@]}"; do
  if ! wait "$PID"; then
    STATUS=1
  fi
done
exit "$STATUS"
